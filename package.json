{
  "name": "sound-audio-visualizer",
  "version": "1.0.0",
  "description": "Real-time audio visualization with live transcription powered by React, Node.js, and Gemini AI",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=server",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "audio",
    "visualization",
    "transcription",
    "gemini",
    "socket.io",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
